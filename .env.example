# ==============================================================================
# Game Card Marketplace - Environment Variables Setup
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to exactly `.env` (do not commit it to git!)
# 2. Replace the placeholder values below with your actual API keys and secrets.
# ==============================================================================

# Your Alchemy API Key (for Polygon Mumbai / Amoy testnets)
VITE_ALCHEMY_API_KEY=YOUR_ALCHEMY_MUMBAI_KEY

# Your NFT.storage API Key (for uploading metadata and images to IPFS)
VITE_NFT_STORAGE_API_KEY=YOUR_NFT_STORAGE_API_KEY

# The private key of the wallet you will use to deploy the smart contracts
PRIVATE_KEY=YOUR_DEPLOYER_PRIVATE_KEY